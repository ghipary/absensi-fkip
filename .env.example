# ── Database ─────────────────────────────────────────────
# Lokal: SQLite
DATABASE_URL="file:./dev.db"
# Produksi (Vercel + Neon/Postgres): gunakan variabel terpisah di Vercel
# DATABASE_URL="postgresql://user:password@host:5432/siakad_uniwa?sslmode=require"

# ── Mode Data & Auth ──────────────────────────────────────
DATA_SOURCE="mock"    # mock | api
