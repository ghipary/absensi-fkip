// ============================================================
// SIAKAD UNIVERSITAS WAHIDIYAH (Web B)
// Portal Absensi & Kegiatan Perkuliahan
// PostgreSQL · 10 tabel · data master read-only dari Web A
// ============================================================

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "debian-openssl-1.1.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// STRUKTUR AKADEMIK
// ─────────────────────────────────────────────

model Fakultas {
  id        String   @id @default(cuid())
  nama      String   @unique
  createdAt DateTime @default(now())

  prodi     Prodi[]
  mahasiswa Mahasiswa[]
  dosen     Dosen[]
  user      User[]
}

model Prodi {
  id         String  @id @default(cuid())
  fakultasId String
  nama       String
  jenjang    String // S1 | D3

  fakultas  Fakultas  @relation(fields: [fakultasId], references: [id], onDelete: Cascade)
  mahasiswa Mahasiswa[]
  dosen     Dosen[]
  user      User[]

  @@unique([fakultasId, nama, jenjang])
}

model Mahasiswa {
  id         String @id @default(cuid())
  nim        String @unique
  nama       String
  fakultasId String
  prodiId    String
  angkatan   Int
  status     String @default("aktif")

  fakultas Fakultas @relation(fields: [fakultasId], references: [id])
  prodi    Prodi    @relation(fields: [prodiId], references: [id])

  @@index([prodiId])
}

model Dosen {
  id         String  @id @default(cuid())
  nidn       String  @unique
  nama       String
  fakultasId String
  prodiId    String
  jabatan    String?

  fakultas Fakultas @relation(fields: [fakultasId], references: [id])
  prodi    Prodi    @relation(fields: [prodiId], references: [id])
  jadwal   Jadwal[]

  @@index([prodiId])
}

// ─────────────────────────────────────────────
// AKUN & OTORISASI
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  identitas    String   @unique
  nama         String
  email        String   @unique
  passwordHash String
  role         String
  fakultasId   String?
  prodiId      String?
  aktif        Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  fakultas Fakultas? @relation(fields: [fakultasId], references: [id])
  prodi    Prodi?    @relation(fields: [prodiId], references: [id])
}

// ─────────────────────────────────────────────
// PERKULIAHAN
// ─────────────────────────────────────────────

model MataKuliah {
  id     String @id @default(cuid())
  kodeMk String @unique
  namaMk String
  sks    Int

  jadwal Jadwal[]
}

model Jadwal {
  id         String @id @default(cuid())
  kodeMk     String
  kelas      String
  nidnDosen  String
  ruang      String
  hari       String
  jamMulai   String
  jamSelesai String
  semester   String

  mataKuliah MataKuliah @relation(fields: [kodeMk], references: [kodeMk], onDelete: Cascade)
  dosen      Dosen      @relation(fields: [nidnDosen], references: [nidn])
  materi     Materi[]
  absensi    Absensi[]

  @@unique([kodeMk, kelas, semester])
  @@index([nidnDosen])
}

// ─────────────────────────────────────────────
// MATERI & ABSENSI
// ─────────────────────────────────────────────

model Materi {
  id         String   @id @default(cuid())
  jadwalId   String
  judul      String
  deskripsi  String?
  fileUrl    String?
  dibuatOleh String
  tanggal    DateTime @default(now())

  jadwal Jadwal @relation(fields: [jadwalId], references: [id], onDelete: Cascade)

  @@index([jadwalId])
}

model Absensi {
  id               String   @id @default(cuid())
  jadwalId         String
  nim              String
  tanggal          DateTime
  status           String
  waktu            DateTime @default(now())
  diverifikasiOleh String?
  statusVerifikasi String   @default("menunggu")

  jadwal Jadwal @relation(fields: [jadwalId], references: [id], onDelete: Cascade)

  @@unique([jadwalId, nim, tanggal])
  @@index([nim])
}

// ─────────────────────────────────────────────
// LOG
// ─────────────────────────────────────────────

model LogAktivitas {
  id    String   @id @default(cuid())
  user  String
  aksi  String
  waktu DateTime @default(now())
}